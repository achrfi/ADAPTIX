# Copy to .env and fill in. Real environment variables always win over this file.
# Loaded automatically at startup (src/adaptix/config.py:load_dotenv).
# Verify any configuration before a run:  python -m src.adaptix.main --check-model

# ---------------------------------------------------------------------------
# Provider selection
# ---------------------------------------------------------------------------
# Any LiteLLM model string. The prefix decides which provider library is used.
#
#   ollama_chat/qwen3:14b            local Ollama (default, free, no key)
#   openai/gpt-4o-mini               OpenAI
#   anthropic/claude-sonnet-4        Anthropic
#   gemini/gemini-2.5-pro            Google
#   openrouter/deepseek/deepseek-chat  OpenRouter (any of its models)
#   azure/gpt-4o                     Azure OpenAI
#   openai/<model-id>                any OpenAI-compatible gateway (see base URL)
ADAPTIX_LLM_MODEL=

# Base URL for the provider. Required for OpenAI-compatible gateways and local
# proxies (9router, vLLM, LM Studio, Ollama on another host). Usually ends in /v1.
# Leave empty to let LiteLLM use the provider library's own default endpoint.
ADAPTIX_API_BASE=

# API key for a hosted or paid provider. Never written to a report or a checkpoint.
ADAPTIX_API_KEY=

# Local Ollama endpoint, used when no API base is set and the model is an ollama family.
ADAPTIX_OLLAMA_BASE_URL=http://127.0.0.1:11434

# ---------------------------------------------------------------------------
# Model capability (not a spend limit) - set these to match the real model
# ---------------------------------------------------------------------------
# Total context the model accepts. Too small and the planner has no room to
# answer; a 8k window with a 7.8k prompt fails structurally. Use 32768+ for
# hosted models, 8192 for a small local one.
ADAPTIX_MODEL_CONTEXT_TOKENS=8192

# Per-call provider window in seconds. Reasoning models on slow hardware need
# more than a fast hosted model; too short looks identical to a broken provider.
ADAPTIX_LLM_TIMEOUT=120

# ---------------------------------------------------------------------------
# Structured output and reasoning
# ---------------------------------------------------------------------------
# Transport for structured output. Leave unset for gateways: a custom api_base
# is treated as OpenAI-compatible and probed with json_object, because a gateway
# commonly accepts json_schema and then enforces nothing, which leaves the model
# free to violate the schema. Set to "on" only if your gateway really enforces it.
# ADAPTIX_NATIVE_JSON=off

# Suppress hidden reasoning on a reasoning model. Without this a reasoning model
# can spend its whole output budget on reasoning_content and return empty content.
# "none" is the safe default for a gateway; unset lets the model decide.
ADAPTIX_REASONING_EFFORT=none

# Extra retries beyond ADAPTIX_PLANNER_RETRIES are granted automatically when a
# provider returns reasoning with empty content (an intermittent gateway fault),
# so this does not need raising for that case.

# ---------------------------------------------------------------------------
# Budgets for a run
# ---------------------------------------------------------------------------
ADAPTIX_TIME_BUDGET=1800
ADAPTIX_TOOL_CALL_BUDGET=20
# A finite positive number, or "unlimited" to remove only the cumulative token
# ceiling while still metering usage. The TUI can switch at runtime:
# /budget tokens=600000 or /budget tokens=unlimited.
# The planner prompt is ~28k tokens per call on a full observation payload, and a
# retry is metered in full. 50000 stops a hosted run after two or three passes;
# 600000 gave 11 iterations and 9 executed actions in testing.
ADAPTIX_TOKEN_BUDGET=600000

# ---------------------------------------------------------------------------
# Optional tracing
# ---------------------------------------------------------------------------
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
